# Bu dosyayı .env adıyla kopyala ve anahtarını yaz:  cp .env.example .env
# .env dosyası .gitignore'dadır; GitHub'a gitmez. Anahtarını kimseyle paylaşma.

# ── Önerilen: Groq (ücretsiz katman) ── anahtar: console.groq.com/keys
# Modeller bu projenin boyutuna ve bir MacBook Air'e göre seçildi: model bilgisayarında değil, Groq'un
# sunucusunda çalışır; bilgisayarın yalnızca uygulamayı çalıştırır.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Büyük model: plan çizen ve değerlendiren ajanlar (Haritacı, Kutup Yıldızı, Yörüngeci, Kaşif, Hakem). Seyrek çağrılır.
LLM_MODEL=openai/gpt-oss-120b
# Hızlı model: sık çağrılan kısa işler (Gözlemevi, Konu Bekçisi, Rehber, İkiz, Astronom, Kaynak Avcısı, sohbet).
LLM_MODEL_HIZLI=openai/gpt-oss-20b
# Fotoğraftan öğretmek için Groq'un görüntü modeli (önizleme aşamasında; kaldırılırsa satırı boş bırak).
LLM_VISION_MODEL=qwen/qwen3.8-27b
# Sesli anlatım Groq'ta kendiliğinden açılır (whisper-large-v3-turbo); ayar gerekmez.

# ── Seçenek: Google Gemini ── anahtar: aistudio.google.com/apikey
# Aşağıdaki satırları açarsan yukarıdaki Groq satırlarının yerine geçer (dosyada son yazılan geçerlidir).
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=        (ai.google.dev/gemini-api/docs/models sayfasındaki güncel "flash" modeli)
# LLM_MODEL_HIZLI=  (aynı sayfadaki "flash-lite" modeli)
# LLM_VISION_MODEL=

# ── Seçenek: Anthropic Claude ──
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=         (boşsa claude-sonnet-5-5)
# ANTHROPIC_MODEL_HIZLI=   (boşsa ANTHROPIC_MODEL)

# ── Seçenek: tamamen kendi bilgisayarında (Ollama) ──
# Fansız bir MacBook Air'de yavaştır ve ısınır; jüri sunumu için Groq önerilir.
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gpt-oss:20b
# LLM_MODEL_HIZLI=gpt-oss:20b

# İsteğe bağlı
# IKIZ_DB=ikiz.db
# IKIZ_PROXY=1            (Render/Railway gibi bir proxy arkasında yayınlarken)
