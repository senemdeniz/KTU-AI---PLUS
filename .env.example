# Bu dosyayı .env adıyla kopyala ve anahtarını yaz:  cp .env.example .env
# .env dosyası .gitignore'dadır; GitHub'a gitmez. Anahtarını kimseyle paylaşma.

# Seçenek A: Groq (ücretsiz katman, metin + ses + görüntü) — console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Fotoğraftan öğretmek için Groq'un görüntü modeli (console.groq.com/docs/vision sayfasındaki güncel ad)
LLM_VISION_MODEL=

# Seçenek B: Google Gemini (ücretsiz katman) — aistudio.google.com/apikey
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=   (ai.google.dev/gemini-api/docs/models sayfasındaki güncel "flash" modelinin adı)

# Seçenek C: Anthropic Claude
# ANTHROPIC_API_KEY=

# İsteğe bağlı
# IKIZ_DB=ikiz.db
