{
  "name": "İkiz",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt",
  "postStartCommand": "nohup python3 -m uvicorn server:app --host 0.0.0.0 --port 8000 > /tmp/ikiz.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "İkiz", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "LLM_API_KEY": {
      "description": "Groq ya da Gemini API anahtarı. Boş bırakırsan ajanlar demo içerikle çalışır.",
      "documentationUrl": "https://console.groq.com/keys"
    },
    "LLM_BASE_URL": {
      "description": "Örn. https://api.groq.com/openai/v1"
    },
    "LLM_MODEL": {
      "description": "Örn. openai/gpt-oss-120b"
    }
  }
}
