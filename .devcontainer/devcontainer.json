{
  "name": "İkiz",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt",
  "postStartCommand": "IKIZ_PROXY=1 nohup python3 -m uvicorn server:app --host 0.0.0.0 --port 8000 > /tmp/ikiz.log 2>&1 &",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "İkiz",
      "onAutoForward": "openBrowser"
    }
  },
  "secrets": {
    "LLM_API_KEY": {
      "description": "Groq API anahtarı (console.groq.com/keys). Boş bırakırsan ajanlar demo içerikle çalışır.",
      "documentationUrl": "https://console.groq.com/keys"
    },
    "LLM_BASE_URL": {
      "description": "https://api.groq.com/openai/v1"
    },
    "LLM_MODEL": {
      "description": "Büyük model: openai/gpt-oss-120b"
    },
    "LLM_MODEL_HIZLI": {
      "description": "Hızlı model: openai/gpt-oss-20b"
    },
    "LLM_VISION_MODEL": {
      "description": "Görüntü modeli (isteğe bağlı): qwen/qwen3.8-27b"
    }
  }
}
