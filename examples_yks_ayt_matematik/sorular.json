[
 {
  "id": "tk-01",
  "eyalet": "tk",
  "zorluk": 3,
  "kalip": "Rakam bulma + bölünebilme",
  "soru": "a ve b birer rakam olmak üzere, beş basamaklı 2a73b sayısı 45 ile tam bölünebilmektedir.\nBuna göre, a'nın alabileceği değerlerin toplamı kaçtır?",
  "secenek": [
   "1",
   "6",
   "7",
   "8",
   "9"
  ],
  "dogru": "C",
  "tuzak": {
   "A": {
    "tur": "dikkat_hatasi",
    "not": "Yalnızca b = 5 durumunu buldun; b = 0 durumunu atladın."
   },
   "B": {
    "tur": "dikkat_hatasi",
    "not": "Yalnızca b = 0 durumunu buldun; b = 5 durumunu atladın."
   },
   "D": {
    "tur": "bilgi_eksigi",
    "not": "45 = 5·9 ayrımını kullanmadan 9 kuralını tek başına uyguladın."
   },
   "E": {
    "tur": "bilgi_eksigi",
    "not": "Son basamak koşulunu (0 ya da 5) hiç kullanmadın."
   }
  },
  "cozum": "45 = 5·9. 5 için b ∈ {0, 5}. 9 için 2+a+7+3+b = 12+a+b, 9'un katı olmalı. b = 0 → a = 6; b = 5 → a = 1. Toplam 1 + 6 = 7."
 },
 {
  "id": "mk-02",
  "eyalet": "mk",
  "zorluk": 2,
  "kalip": "Küme eleman sayısı",
  "soru": "A ve B sonlu kümeleri için s(A) = 12, s(B) = 9 ve s(A ∪ B) = 16'dır.\nBuna göre, s(A \\ B) + s(B \\ A) toplamı kaçtır?",
  "secenek": [
   "4",
   "5",
   "7",
   "11",
   "16"
  ],
  "dogru": "D",
  "tuzak": {
   "A": {
    "tur": "islem_hatasi",
    "not": "s(B \\ A) değerini buldun, ikisini toplamayı unuttun."
   },
   "B": {
    "tur": "kavram_yanilgisi",
    "not": "Bulduğun s(A ∩ B) değerini sonuç sandın."
   },
   "C": {
    "tur": "islem_hatasi",
    "not": "Yalnızca s(A \\ B) değerini buldun."
   },
   "E": {
    "tur": "kavram_yanilgisi",
    "not": "s(A ∪ B)'yi sonuç sandın; kesişimi çıkarmadın."
   }
  },
  "cozum": "s(A ∩ B) = 12 + 9 − 16 = 5. s(A \\ B) = 7 ve s(B \\ A) = 4. Toplam 11."
 },
